{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": true,
    "tsBuildInfoFile": "dist/tsconfig.serve.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/test/**", "src/outdated", "src/benchmark", "web"]
}
