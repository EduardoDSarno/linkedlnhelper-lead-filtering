# Every value below is optional except the secrets. Blank uses the default
# defined in code next to the setting.

# ── Secrets (required) ────────────────────────────────────────────
# Apify token, used by the Harvest profile scraper.
APIFY_API_KEY=

# OpenRouter key. Every model call runs through OpenRouter.
OPENROUTER_API_KEY=

# Unipile workspace, both from its dashboard: the DSN (host and port, shown
# there without https://) and an access token. They are the only link between
# the code and one Unipile account; another workspace means changing these.
UNIPILE_DSN=
UNIPILE_ACCESS_TOKEN=

# ── Model ─────────────────────────────────────────────────────────
# OpenRouter model id. Must accept images while profile photos are sent.
OPENROUTER_MODEL=

# Reasoning depth: low, medium, high, or max.
OPENROUTER_MODEL_THINKING_EFFORT=

# Most a backend may charge, in USD per million tokens. A ceiling, not a price
# sort: sorting would pin every request to the cheapest and slowest backend.
OPENROUTER_MAX_PROMPT_PRICE=
OPENROUTER_MAX_COMPLETION_PRICE=

# ── Evaluation tuning ─────────────────────────────────────────────
# Profiles per model request. Kept small because each request also carries
# that many photos, and matching a photo to its person degrades as it grows.
EVALUATION_PROFILES_PER_REQUEST=

# Requests in flight at once.
EVALUATION_CONCURRENCY=

# Budget for a request's first attempt; a retry gets a fraction of it.
EVALUATION_REQUEST_TIMEOUT_MS=

# Attempts per request, the first one included.
EVALUATION_MAXIMUM_ATTEMPTS=

# Base backoff between attempts, before it grows.
EVALUATION_RETRY_BASE_DELAY_MS=

# ── Harvest profile scraper (Apify) ───────────────────────────────
# Profiles per Actor run.
APIFY_BATCH_SIZE=

# Actor runs in flight at once.
APIFY_BATCH_CONCURRENCY=

# Attempts per profile, the first one included.
APIFY_MAX_ATTEMPTS=

# Base backoff between attempts, before jitter.
APIFY_RETRY_BASE_DELAY_MS=

#port for running the server
PORT=

# Public address of this server, e.g. an ngrok URL, without a trailing slash.
# Unipile sends its messages to this address plus a route path.
PUBLIC_URL=


DATABASE_URL=
# Secret to access the webhook
UNIPILE_WEBHOOK_SECRET=

# ── Web app ───────────────────────────────────────────────────────
# Days a login lasts before signing in again.
SESSION_DAYS=

# ── LinkedIn ──────────────────────────────────────────────────────
# fake: generated sample people, nothing reaches LinkedIn (the default).
# unipile: real accounts through Unipile; needs the Unipile values above.
LINKEDIN_MODE=

# ── Account safety caps ───────────────────────────────────────────
# Per LinkedIn account, shared by all its campaigns. A value above the hard
# limit written in src/scheduler/limits.ts is lowered to it, so a typo here
# cannot get an account restricted.
# Invites over a rolling 7 days.
ACCOUNT_WEEKLY_INVITE_CAP=
# Profile fetches over a rolling 24 hours.
ACCOUNT_DAILY_PROFILE_CAP=

# ── Collection pipeline (npm run worker) ──────────────────────────
# Profiles gathered before they are evaluated together.
PIPELINE_EVALUATION_BATCH_SIZE=
# Days a fetched profile is reused before it is fetched again.
PROFILE_REFRESH_DAYS=
# Failed fetches before a lead is marked failed.
PIPELINE_MAX_FETCH_ATTEMPTS=
# Search pages per campaign per pass, so searching spreads over the day.
PIPELINE_SEARCH_PAGES_PER_PASS=
# Rest between two passes over the active campaigns.
PIPELINE_PASS_INTERVAL_MS=
# Random pause before each LinkedIn action, between min and max. A minimum
# below the hard floor in src/pipeline/config.ts is raised to it.
ACTION_DELAY_MIN_MS=
ACTION_DELAY_MAX_MS=

# ── Working time (LinkedIn actions only happen inside it) ─────────
# IANA timezone of the accounts, e.g. America/Sao_Paulo.
WORK_TIMEZONE=
# Hours as 0-24; start is included, end is not.
WORK_START_HOUR=
WORK_END_HOUR=
# ISO weekdays, Monday = 1 … Sunday = 7, comma-separated.
WORK_DAYS=

# ── Agent ─────────────────────────────────────────────────────────
# Who drives the worker: agent (default) wakes each account's agent;
# autopilot runs the fixed search → fetch → evaluate → invite sequence.
WORKER_MODE=
# OpenRouter model for the agent; blank uses OPENROUTER_MODEL. Must support tools.
AGENT_MODEL=
# Most model calls in one agent run.
AGENT_MAX_STEPS=
# How often each account's agent gets a scheduled check-in.
AGENT_WAKE_INTERVAL_MS=
