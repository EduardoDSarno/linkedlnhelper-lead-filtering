# ── Secrets (required) ────────────────────────────────────────────
# Apify / HarvestAPI token. Without it, collection throws at startup.
APIFY_API_KEY=

# OpenRouter API key. Every model stage runs through OpenRouter.
OPENROUTER_API_KEY=

# OpenRouter model shared by evaluation and image analysis. Blank uses the
# configured default (a vision-capable id is required once images are sent).
OPENROUTER_MODEL=

# OpenRouter reasoning depth: low, medium, high, or max. Blank uses high.
OPENROUTER_MODEL_THINKING_EFFORT=

# Evaluation requests in flight at once; blank uses the configured default
# (10). Hard ceiling is 100.
EVALUATION_CONCURRENCY=

# ── Apify collector tuning (optional) ─────────────────────────────
# Which Apify Actor collects full profiles: hybrid, bebity, or harvest.
# hybrid sends everything Bebity can safely handle to Bebity and falls back
# to Harvest for the rest (a slug Bebity would truncate, or a profile Bebity
# actually tried and failed on) — see apify_pipeline.ts. bebity and harvest
# use only that one provider, no fallback; useful for cost benchmarking or
# isolating which provider produced a result. Blank uses the configured
# default (hybrid). An unrecognized value is rejected at startup rather than
# silently falling back, because these differ in cost, coverage, and schema.
APIFY_PROFILE_COLLECTOR=

# Profiles per Actor run; blank uses the configured default.
APIFY_BATCH_SIZE=

# Actor runs in flight at once; blank uses the configured default.
APIFY_BATCH_CONCURRENCY=

# Attempts per profile, initial try included; blank uses the configured default.
APIFY_MAX_ATTEMPTS=

# Base retry backoff before jitter; blank uses the configured default.
APIFY_RETRY_BASE_DELAY_MS=

# Bebity shares APIFY_BATCH_SIZE with Harvest above, but has its own
# concurrency default (15) instead of inheriting Harvest's more conservative
# one (6, tuned for HarvestAPI's queue limit — see APIFY_COLLECTOR_CONFIG.md).
# A paid benchmark (output/benchmarks/bebity/, sweep across concurrency
# 6/10/15 at production batch size) found no Bebity failures up to 15. Blank
# uses the configured default. Apify's platform itself caps concurrent Actor
# runs account-wide by subscription plan; on the current plan ("Started")
# that ceiling is 35, shared across every provider running at once.
BEBITY_BATCH_CONCURRENCY=

# Which optional LinkedIn sections Bebity fetches per profile, comma-separated:
# about, experience, languages, skills, honors, projects, organizations (or
# "all"). Each one is a separate LinkedIn request per profile — more fields
# means more cost and latency per profile. Blank uses the configured default
# (about, experience), which is what full profile mapping currently relies on.
BEBITY_PROFILE_FIELDS=


# ── Image analysis tuning (optional) ──────────────────────────────
# Images analyzed at once; blank uses the configured default (25). Hard
# ceiling is 100.
IMAGE_ANALYSIS_CONCURRENCY=

# One image request's timeout in ms; blank uses the configured default.
IMAGE_REQUEST_TIMEOUT_MS=

# Image tokenization resolution: low, medium, or high; blank uses the default.
IMAGE_ANALYSIS_RESOLUTION=


# ── Pipeline (optional) ───────────────────────────────────────────
# Most profiles accepted in one run; blank uses the configured default.
MAX_PIPELINE_PROFILES=


# ── Storage (optional) ────────────────────────────────────────────
# SQLite file location; blank uses the configured default.
DATABASE_PATH=

# Hours a finished run's files are kept before cleanup deletes them;
# blank uses the configured default.
PROCESSING_TTL_HOURS=


# ── API server (optional) ─────────────────────────────────────────
# Port the API listens on; blank uses the configured default.
PORT=

# Bind address; blank binds to localhost only. Set 0.0.0.0 to accept
# external connections (for example inside a container).
HOST=


# ── Logging (optional) ────────────────────────────────────────────
# Pino level; blank uses the configured default.
LOG_LEVEL=

# Pipeline log file location; blank uses the configured default.
LOG_PATH=
