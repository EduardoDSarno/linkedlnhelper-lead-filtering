    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.2.103",
    "apify-client": "^2.25.0",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pino": "^10.3.1"
  },
  "engines": {
    "node": ">=22"
  },
