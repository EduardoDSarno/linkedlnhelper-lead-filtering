{
  "name": "linkedlnhelper-lead-filtering",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "review": "tsx src/index.ts --review",
    "serve": "tsc -p tsconfig.serve.json && node dist/api/server.js",
    "test": "npm run typecheck && npm run test:unit",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "typecheck:experiments": "tsc -p tsconfig.experiments.json --noEmit",
    "test:experiments": "node --import tsx --test 'scripts/**/test/*.test.ts'",
    "test:unit": "node --import tsx --test 'src/**/test/*.test.ts'",
    "app": "npm run build:app && node dist/api/server.js",
    "build:app": "tsc -p tsconfig.serve.json && npm --prefix web run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@openrouter/sdk": "^1.2.103",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "pino": "^10.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "22.23.2"
  }
}
