{
  "name": "linkedlnhelper-lead-filtering",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "serve": "node --watch --env-file=.env --import tsx src/api/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "worker": "node --env-file=.env --import tsx src/pipeline/worker.ts",
    "unipile:webhooks": "node --env-file=.env --import tsx src/scripts/register_unipile_webhooks.ts",
    "user:create": "node --env-file=.env --import tsx src/scripts/create_user.ts",
    "test": "npm run typecheck && npm run test:unit",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc --noEmit -p web",
    "test:unit": "node --import tsx --test 'src/**/test/*.test.ts'",
    "db:migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "db:run": "f() { psql postgres://admin:app@localhost:5432/linkedlead -f \"src/db/sql/$1\"; }; f",
    "db:check": "f() { psql postgres://admin:app@localhost:5432/linkedlead -c \"\\d $1\"; }; f",
    "db:query": "psql postgres://admin:app@localhost:5432/linkedlead -c"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openrouter/sdk": "^1.2.103",
    "apify-client": "^2.25.0",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "zod": "^4.6.6"
  },
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "22.23.2"
  }
}
