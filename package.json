  "main": "index.js",
  "scripts": {
    "serve": "node --watch --env-file=.env --import tsx src/api/server.ts",
    "test": "npm run typecheck && npm run test:unit",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test:unit": "node --import tsx --test 'src/**/test/*.test.ts'",
    "db:run": "psql postgres://admin:app@localhost:5432/linkedlead -f",
    "db:check": "psql postgres://admin:app@localhost:5432/linkedlead -c"
  },
